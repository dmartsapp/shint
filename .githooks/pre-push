#!/usr/bin/env bash
# Pushing main or a release tag needs a signed check report for the commit (see
# .github/scripts/attest.sh); this makes one if there is none. Installed by `make hooks`.
#
# It is a convenience, not the gate: a hook lives on one machine and `git push --no-verify`
# skips it. The gate is CI, which runs the whole suite whenever there is no valid report.
# SHINT_SKIP_ATTEST=1 pushes without one, on purpose.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"
zeros='^0+$'

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main|refs/tags/v[0-9]*) ;; *) continue;; esac
  [[ "$local_sha" =~ $zeros ]] && continue          # a deletion
  if [ -n "${SHINT_SKIP_ATTEST:-}" ]; then
    echo "pre-push: SHINT_SKIP_ATTEST is set: pushing $remote_ref without a signed check report (CI will run the whole suite)"; continue
  fi
  commit="$(git rev-parse "$local_sha^{commit}")"
  tmp="$(mktemp -d)"
  if git notes --ref=checks show "$commit" > "$tmp/note" 2>/dev/null && [ -f "$root/.github/allowed_signers" ] \
     && python3 "$root/.github/scripts/check-report.py" verify --note "$tmp/note" --allowed-signers "$root/.github/allowed_signers" --tree "$(git rev-parse "$commit^{tree}")" >/dev/null 2>&1; then
    rm -rf "$tmp"; echo "pre-push: ${commit:0:12} has a valid signed check report"; continue
  fi
  rm -rf "$tmp"
  if [ "$commit" != "$(git rev-parse HEAD)" ] || [ -n "$(git status --porcelain)" ]; then
    echo "pre-push: ${commit:0:12} has no valid signed check report, and it is not the clean checked-out commit, so it cannot be checked here." >&2
    echo "          Check it out and run make attest, or push with SHINT_SKIP_ATTEST=1 (CI then runs the whole suite)." >&2
    exit 1
  fi
  echo "pre-push: no valid signed check report for ${commit:0:12}: running make attest (a minute or two; SHINT_SKIP_ATTEST=1 skips it)"
  (cd "$root" && make attest) || { echo "pre-push: the check or the signing failed: not pushing" >&2; exit 1; }
done
exit 0
